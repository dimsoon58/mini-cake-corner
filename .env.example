# Copy this file to `.env` and fill in the values from your Supabase project.
# Find them in the Supabase dashboard under Project Settings → API,
# or in the Lovable project's connected Supabase integration.
# These are VITE_ (client-side) values and are safe to expose in the browser.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Server-side secrets — NOT set here. These are configured in Supabase
# (Dashboard → Edge Functions → Secrets, or `supabase secrets set`). They
# must never be exposed to the browser and never committed.
#
#   GOOGLE_MAPS_SERVER_KEY   Google Maps Platform API key, restricted to
#                            "Places API (New)" + "Routes API". Used only by
#                            the google-places-autocomplete and
#                            resolve-delivery-quote edge functions and by
#                            create-postfinance-payment (delivery distance).
# ─────────────────────────────────────────────────────────────────────────
